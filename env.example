# Persistent Chromium profile holding the session. Seeded by one interactive
# login; keeps the OzonID state that checkout needs.
OZON_PROFILE_DIR=/data/profile

# Copy of a profile known to be signed in; a sign-out is recovered from it.
OZON_PROFILE_BACKUP=/data/profile.backup

# Legacy storageState snapshot, imported once to seed a brand-new profile.
OZON_STATE_PATH=/data/state.json

# curl_cffi TLS-impersonation profile used for direct HTTP requests.
OZON_IMPERSONATE=chrome124

# Optional installed Google Chrome channel. Unset keeps Playwright's Chromium.
# The only accepted value is chrome.
# OZON_BROWSER_CHANNEL=chrome

# Catalog reads. composer is the default JSON API. public reads schema.org data
# from the already open browser page and does not call the composer API or
# follow its redirects. It is not selected automatically.
OZON_STOREFRONT=composer

# Explicit proxy for both the browser and the HTTP client. Unset means direct,
# and the HTTP client does not inherit http_proxy or NO_PROXY. There is no
# built-in proxy endpoint.
# OZON_PROXY_URL=http://proxy.example:8080

# With a proxy URL, ask Chromium to resolve destinations at the proxy and
# exclude only that proxy host. Off unless set. This is not a destination bypass.
# OZON_PROXY_REMOTE_DNS=0

# Seconds to wait for the session thread during shutdown. A timeout does not
# delete profile locks and does not kill the browser thread.
OZON_SHUTDOWN_TIMEOUT=5

# Timeout and retry policy for GET/HEAD reads. POST requests are attempted once;
# read back account state before retrying a failed mutation. Retry-After for
# reads is honoured, capped by the cap.
OZON_REQUEST_TIMEOUT=30
OZON_REQUEST_ATTEMPTS=3
OZON_RETRY_BACKOFF_SECONDS=1
OZON_RETRY_CAP_SECONDS=20

# Budget for a browser navigation or a login step, in seconds.
OZON_BROWSER_TIMEOUT=60

# Close the browser after this many idle seconds; the HTTP session stays.
OZON_IDLE_SECONDS=600

# Allow only cart quantity and selection changes. Off by default.
OZON_ENABLE_CART=0

# Enable broad account writes: cart, favorites, lists, checkout options,
# cancellations and payments for EXISTING orders. Off by default.
# For cart-only access, leave this and OZON_ENABLE_ORDERS at 0.
OZON_ENABLE_WRITES=0

# Allow place_order. SPENDS MONEY — gated separately from the flag above.
OZON_ENABLE_ORDERS=0

# Where the favorites price-monitoring history is persisted.
OZON_MONITOR_STORE=/data/price_history.json

# Transport: stdio (client spawns the process), http (streamable HTTP at /mcp,
# what clients use now) or sse (the deprecated event stream at /sse).
OZON_TRANSPORT=stdio

# Bind address and port for the http and sse transports. The same port serves
# /metrics.
OZON_HOST=127.0.0.1
OZON_PORT=8084

# Required for http/sse, including /metrics. Generate a secret with
# python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Send it as Authorization: Bearer <token> on every HTTP request.
# OZON_AUTH_TOKEN=<at least 32 printable non-space characters>

# Nonempty Host allowlist; "host:*" allows any port on that host.
# For a remote hostname, name it explicitly. A wildcard host is rejected.
OZON_ALLOWED_HOSTS=["127.0.0.1:*","localhost:*","[::1]:*"]

# Browser origins, checked when an Origin header is present. [] denies all
# Origin-bearing requests. Add the exact HTTPS origin for a remote client.
OZON_ALLOWED_ORIGINS=["http://127.0.0.1:*","http://localhost:*","http://[::1]:*"]
